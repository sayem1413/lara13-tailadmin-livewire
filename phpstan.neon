includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        - tests/Fixtures/

    # Spatie's own published stub references Media Library Pro's optional
    # TemporaryUpload model, which isn't installed and isn't needed unless
    # Media Library Pro is added later.
    excludePaths:
        - config/media-library.php

    level: 7
